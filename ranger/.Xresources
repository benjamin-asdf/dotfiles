! Xft.dpi:       132
Xft.dpi:       120
Xft.antialias: true
Xft.hinting:   true
Xft.rgba:      rgb
Xft.autohint:  false
Xft.hintstyle: hintslight
Xft.lcdfilter: lcddefault

Xcursor.theme: Adwaita
Xcursor.size:  0

emacs*useXIM: off

! mememacs palette, see mememacs/.emacs-mememacs.d/lisp/visual.el.
! fg/bg are swapped on purpose: XTerm*reverseVideo turns them into
! black background + hint-of-red text (the Claude Code look depends on it).
! palette: _ hint-of-red mint-bright-4 mint-bright-3 mint-bright-3 mint-bright-3
*foreground: #000000
*background: #faf7f7
*pointerColor:           #d5ffd2
*pointerColorBackground: #c0febc
*pointerColorForeground: #c0febc
*cursorColor:            #c0febc
*fading:    8
*fadeColor: black

!! black: woodsmoke-tint-1 / scarpa-flow
! palette: woodsmoke-tint-1 scarpa-flow sweet-pink sundown fruit-salad mint-green gimbled peach-orange
*color0:  #2e2d35
*color8:  #5d5c62
!! red: sweet-pink / sundown
*color1:  #fe9aa1
*color9:  #feaeb4
!! green: fruit-salad / mint-green
*color2:  #479b59
*color10: #96fe8f
!! yellow: gimbled / peach-orange
*color3:  #bcb66d
*color11: #ffd2a0
!! blue: horison / anakiwa
! palette: horison anakiwa heliotrope mauve glacier aquamarine _ hint-of-red
*color4:  #5F89A9
*color12: #8fcefe
!! magenta: heliotrope / mauve
*color5:  #F689FF
*color13: #F8A0FF
!! cyan: glacier / aquamarine
*color6:  #6da2bc
*color14: #a0ffd2
!! white: light grey / hint-of-red
*color7:  #d8d8d8
*color15: #faf7f7

XTerm*faceName:          Fixed
XTerm*faceSize:          18
XTerm*reverseVideo:      on
XTerm*selectToClipboard: true
! Default list of xterm minus SetSelection: lets OSC 52 write the clipboard, so
! Claude Code / tmux over ssh (gamelap, Mac) can copy into the clipboard of
! this machine. GetSelection stays blocked: remote programs cannot read it.
XTerm*disallowedWindowOps: GetChecksum,GetIconTitle,GetSelection,GetWinTitle,SetXprop
XTerm.vt100.backarrowKey: false
XTerm.ttyModes: erase ^?
XTerm.vt100.metaSendsEscape: true

! scrollback buffer (needed for the scroll-back/-forw actions below)
XTerm*saveLines: 50000

! key actions:
!   Ctrl+Shift+R          -> repaint the whole screen (after a resize / garbled output)
!   Shift+PageUp/PageDown -> scroll the scrollback buffer (default, kept explicit)
XTerm.vt100.translations: #override \n\
    Ctrl Shift <Key>R:  redraw() \n\
    Shift <Key>Prior:   scroll-back(1,halfpage) \n\
    Shift <Key>Next:    scroll-forw(1,halfpage)
