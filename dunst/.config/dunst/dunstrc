[global]
    mouse_left_click = do_action, close_current
    mouse_right_click = close_current
    monitor = 0
    follow = keyboard
    width = 370
    height = 350
    offset = 0x19
    padding = 2
    horizontal_padding = 2
    transparency = 0
    frame_width = 2
    frame_color = "#2e2d35"
    corner_radius = 8
    font = Monospace 12
    format = "<b>%s</b>\n%b"

[urgency_low]
    background = "#121218"
    foreground = "#Ac98bf"
    frame_color = "#2e2d35"
    timeout = 3

[urgency_normal]
    background = "#121218"
    foreground = "#f0fff0"
    frame_color = "#a1fe9a"
    timeout = 5

[urgency_critical]
    background = "#121218"
    foreground = "#f0fff0"
    frame_color = "#ffa500"
    timeout = 0
