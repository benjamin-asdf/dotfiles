#!/bin/sh

# Kill qutebrowser, even when it is hung.
#
# A wedged qutebrowser (main thread stuck in a futex, windows not repainting
# until you switch StumpWM groups) ignores SIGTERM, because qutebrowser only
# acts on signals from its Qt event loop. So: ask nicely, wait a few seconds,
# then SIGKILL the main process and any QtWebEngineProcess children left over.
#
# A SIGKILLed qutebrowser does not save its session on exit; with
# auto_save.session = True the last periodic autosave is what gets restored.
#
# Before killing, saves per-thread states, the SIGUSR1 Python stack dump
# (qutebrowser's stderr, redirected in config.py), native stacks and a core
# dump (the two newest are kept) to ~/.local/state/qute-hangs/.
# QUTE_KILL_NO_DIAG=1 skips that.
#
# Usage: qute-kill [seconds-to-wait-before-SIGKILL]   (default 5)

wait_s=${1:-5}

pids=$(pgrep -f '^(/usr/bin/)?python3? /usr/bin/qutebrowser')
if [ -z "$pids" ]; then
	echo "qutebrowser is not running"
	exit 0
fi

collect_hang_info() {
	dir=~/.local/state/qute-hangs/$(date +%Y-%m-%dT%H-%M-%S)
	mkdir -p "$dir"
	log=~/.local/state/qutebrowser/stderr.log
	offset=$(stat -c %s "$log" 2>/dev/null || echo 0)
	for pid in $pids $(pgrep -f 'QtWebEngineProcess.*--application-name=qutebrowser'); do
		echo "== $pid $(tr '\0' ' ' </proc/$pid/cmdline | cut -c1-150)"
		for t in /proc/$pid/task/*; do
			printf '%s\t%s\t%s\t%s\n' "${t##*/}" "$(cat $t/comm)" \
				"$(cut -d' ' -f3 $t/stat)" "$(cat $t/wchan)"
		done
	done >"$dir/threads.txt" 2>&1
	for pid in $pids; do
		kill -USR1 "$pid"
		DEBUGINFOD_URLS= timeout 30 eu-stack -m -s -p "$pid" >"$dir/native-$pid.txt" 2>&1
		DEBUGINFOD_URLS= timeout 120 gdb -batch -nx -p "$pid" \
			-ex "gcore $dir/core.$pid" >"$dir/gcore-$pid.log" 2>&1
		ss -xp | grep -E "pid=$pid," >"$dir/sockets-$pid.txt"
	done
	timeout 3 xprop -root _NET_ACTIVE_WINDOW >"$dir/x-responsive.txt" 2>&1 ||
		echo "xprop failed or timed out: $?" >>"$dir/x-responsive.txt"
	pgrep -a picom >"$dir/picom.txt"
	sleep 1
	tail -c +"$((offset + 1))" "$log" >"$dir/stderr-tail.txt" 2>/dev/null
	ls -d ~/.local/state/qute-hangs/*/core.* 2>/dev/null | head -n -2 | xargs -r rm -f
	echo "hang info: $dir"
}

[ "${QUTE_KILL_NO_DIAG:-}" ] || collect_hang_info

kill -TERM $pids 2>/dev/null

i=0
while [ "$i" -lt "$((wait_s * 2))" ]; do
	pgrep -f '^(/usr/bin/)?python3? /usr/bin/qutebrowser' >/dev/null || break
	sleep 0.5
	i=$((i + 1))
done

if pgrep -f '^(/usr/bin/)?python3? /usr/bin/qutebrowser' >/dev/null; then
	echo "qutebrowser ignored SIGTERM for ${wait_s}s, sending SIGKILL"
	kill -KILL $pids 2>/dev/null
	sleep 0.5
else
	echo "qutebrowser exited cleanly"
fi

pkill -KILL -f 'QtWebEngineProcess.*--application-name=qutebrowser' 2>/dev/null
exit 0
