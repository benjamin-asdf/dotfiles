#!/usr/bin/env bash
# desc: qutebrowser quickmarks and bookmarks
# key: b
# Reads the files directly; qutebrowser need not run.
q="${XDG_CONFIG_HOME:-$HOME/.config}/qutebrowser"
[[ -r "$q/quickmarks" ]] && awk '{ url = $NF; $NF = ""; sub(/ $/, ""); print "url\t" $0 "  " url "\t" url }' "$q/quickmarks"
[[ -r "$q/bookmarks/urls" ]] && awk '{ url = $1; $1 = ""; sub(/^ /, ""); print "url\t" ($0 == "" ? url : $0 "  " url) "\t" url }' "$q/bookmarks/urls"
exit 0
