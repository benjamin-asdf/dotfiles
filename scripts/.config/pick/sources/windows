#!/usr/bin/env bash
# desc: StumpWM windows, all groups
# key: w
# verb: focus
# Lines: window<TAB>[group] Class: title<TAB>xid
command -v stumpish >/dev/null || exit 0
f=$(mktemp "${TMPDIR:-/tmp}/pick-windows.XXXXXX")
trap 'rm -f "$f"' EXIT
stumpish eval "(with-open-file (s \"$f\" :direction :output :if-exists :supersede)
  (flet ((clean (x) (substitute-if #\\Space (lambda (c) (member c '(#\\Tab #\\Newline #\\Return)))
                                   (princ-to-string (or x \"\")))))
    (dolist (w (stumpwm::all-windows))
      (format s \"window~c[~a] ~a: ~a~c~d~%\" #\\Tab
              (clean (group-name (window-group w))) (clean (window-class w))
              (clean (stumpwm::window-name w)) #\\Tab (xlib:window-id (window-xwin w))))) nil)" \
    >/dev/null 2>&1 || exit 0
cat "$f"
