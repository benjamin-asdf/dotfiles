#!/usr/bin/env bash
# types: window mark
# default: window mark
# desc: focus the window (StumpWM)
v=$(cat)
case "$1" in
    window)
        [[ "$v" =~ ^[0-9]+$ ]] || exit 1
        stumpish eval "(let ((w (find $v (stumpwm::all-windows) :key (lambda (w) (xlib:window-id (window-xwin w))))))
                         (if w (progn (stumpwm::focus-all w) t) (progn (message \"window gone\") nil)))" >/dev/null ;;
    mark)
        [[ "$v" =~ ^[a-z]$ ]] || exit 1
        stumpish eval "(progn (stumpwm::mark-jump #\\$v (current-window)) (stumpwm::marks-save) t)" >/dev/null ;;
esac
