#!/usr/bin/env bash
# types: pass
# default: pass
# desc: copy the password (pass -c, clipmenud paused)
v=$(cat)
command -v clipctl >/dev/null && clipctl disable >/dev/null 2>&1
pass show -c "$v" >/dev/null 2>&1; rc=$?
command -v clipctl >/dev/null && clipctl enable >/dev/null 2>&1
if (( rc == 0 )); then
    notify-send -a pick -u low "pass: $v copied" "clears in ${PASSWORD_STORE_CLIP_TIME:-45}s" 2>/dev/null
else
    notify-send -a pick -u critical "pass: $v failed" 2>/dev/null; exit 1
fi
